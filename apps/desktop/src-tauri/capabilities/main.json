{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with no filesystem or shell plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "core:path:allow-join",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm"
  ]
}
